#!/usr/bin/env sh

# Test script for rtedit
# This script verifies basic functionality of rtedit

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
RTEDIT_DIR="$REPO_DIR"

# Colors for output (POSIX-compliant octal format)
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Initialize test count
TOTAL_TESTS=0
PASSED_TESTS=0
FAILED_TESTS=0

# Configure Dynamic SSH Test Environment variables
LOCAL_USER=$(whoami)
LOCAL_HOST="localhost"
TEST_CONFIG="$SCRIPT_DIR/ssh_config.run"

# Dynamically construct the loopback config file (POSIX-safe string formatting)
{
    printf 'Host test-loopback\n'
    printf '    HostName 127.0.0.1\n'
    printf '    User %s\n' "$LOCAL_USER"
    printf '    ForwardAgent yes\n'
    printf '    SetEnv BB_USER=%s BB_HOST=%s\n' "$LOCAL_USER" "$LOCAL_HOST"
    printf '    SendEnv BB_USER BB_HOST\n'
    printf '    StrictHostKeyChecking no\n'
    printf '    UserKnownHostsFile /dev/null\n'
    printf '    LogLevel QUIET\n'
} > "$TEST_CONFIG"

# Function to run tests and record results
test_run(){
    TOTAL_TESTS=$((TOTAL_TESTS + 1))
    printf "\n%bTesting: %s%b\n" "${BLUE}" "$1" "${NC}"
    shift
    # Expand $RTEDIT_DIR and $1 locally while deferring $PATH expansion to the remote shell
    # shellcheck disable=SC2087
    if ssh -F "$TEST_CONFIG" test-loopback /bin/sh \
<< EOF
export PATH="$RTEDIT_DIR:\$PATH"
$1
EOF
    then
        printf "%bPassed%b\n" "${GREEN}" "${NC}"
        PASSED_TESTS=$((PASSED_TESTS + 1))
    else
        printf "%bFailed%b\n" "${RED}" "${NC}"
        FAILED_TESTS=$((FAILED_TESTS + 1))
    fi
}

# Test 1: Basic Usage
test_run "Basic Usage" \
    "echo 'Hello, BBEdit!' | rtedit /dev/null"

# Test 2: Environment Variables
test_run "Environment Variables" \
    "rtedit --view-top -m unix-man-page /etc/passwd"

# Test 3: Directory Opening
test_run "Directory Opening" \
    "rtedit ."

# Test 4: File Creation
test_run "File Creation" \
    "echo 'Test content' | rtedit --create test_file.txt && rm test_file.txt"

# Test 5: Error Handling - Invalid File
# Asserts that rtedit fails (!) and prints its environment reminder message
test_run "Error Handling (Invalid File)" \
    "! rtedit non_existent_file 2>&1 | grep -i 'sudo'"

# Test 6: Error Handling - Non-Readable File
test_run "Error Handling (Permissions)" \
    "touch test_file && chmod 000 test_file; rtedit test_file 2>&1 | grep -E -i 'permission|error|13219'; RET=\$?; rm -f test_file; exit \$RET"

# Test 7: Edge Case - No Arguments
test_run "Edge Case (No Arguments)" \
    "rtedit 2>&1 | grep -E -i 'usage|bbedit|rtedit'"

# Test 8: Edge Case - Empty Input
test_run "Edge Case (Empty Input)" \
    "printf '%s' '' | rtedit /dev/null"

# Test 9: Flag Combination - Create + View Top
# Verifies that a file can be created and immediately forced to scroll to the top window view
test_run "Flag Combination (Create + View Top)" \
    "echo 'Line 1\nLine 2' | rtedit --create --view-top test_combo_1.txt && rm test_combo_1.txt"

# Test 10: Flag Combination - Create + Language Mode
# Verifies that rtedit successfully creates a file while overriding the editor syntax mapping
test_run "Flag Combination (Create + Language Mode)" \
    "echo 'print(\"hello\")' | rtedit --create -m python test_combo_2.py && rm test_combo_2.py"

# Test 11: Flag Combination Error - Conflicting Actions
# If your script has mutually exclusive flags (like opening a folder while passing a line-view modification),
# this asserts that the script gracefully fails with a usage/error statement instead of executing.
test_run "Flag Combination Error (Conflicting Arguments)" \
    "! rtedit --view-top . 2>&1 | grep -Ei 'usage|error|bbedit'"

# Test 12: Flag Combination - Permissions + Custom View Override
# Confirms that permission boundaries still catch errors even when passing layout modifiers
test_run "Flag Combination Error (Permissions + View Modifier)" \
    "touch test_combo_priv && chmod 000 test_combo_priv; rtedit --view-top test_combo_priv 2>&1 | grep -Ei 'permission|error|100013'; RET=\$?; rm -f test_combo_priv; exit \$RET"

# Summary
printf "\n%bTest Summary %s%b\n" "${BLUE}" "$(date +%m/%d/%Y)" "${NC}"
printf "Total tests: %s\n" "${TOTAL_TESTS}"
printf "Passed: %s (%s/%s)\n" "${PASSED_TESTS}" "${PASSED_TESTS}" "${TOTAL_TESTS}"
printf "Failed: %s\n" "${FAILED_TESTS}"

# Wipe runtime artifacts
rm -f "$TEST_CONFIG"

# Return the number of failed tests
exit "$FAILED_TESTS"
